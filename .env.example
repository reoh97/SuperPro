# SuperPro 비밀키 — 서버에서 이 파일을 복사해 '.env' 로 만들고 값을 채운다.
#   cp .env.example .env   그다음 .env 편집(nano .env)
# .env 는 git에 안 올라간다(.gitignore). 토큰을 코드 저장소에 절대 커밋하지 말 것.

# 텔레그램 (알림 + 원격제어)
TELEGRAM_BOT_TOKEN=여기에_BotFather_토큰
TELEGRAM_CHAT_ID=여기에_본인_chat_id

# 업비트 실거래 키 (모의가동(paper)에선 불필요 — 실전 전환 시에만)
# UPBIT_ACCESS_KEY=
# UPBIT_SECRET_KEY=
